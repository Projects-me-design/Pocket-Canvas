{
  "appId": "com.projecttechme.pocketcanvas",
  "appName": "Pocket-Canvas",
  "webDir": "build/mobile-www",
  "android": {
    "path": "android",
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "ios": {
    "path": "ios",
    "contentInset": "never",
    "scrollEnabled": false
  },
  "plugins": {
    "SystemBars": { "insetsHandling": "css" }
  }
}
