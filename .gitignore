# Pocket-Canvas — files Git should never upload

# Installed packages (recreated by "npm install")
node_modules/

# Build output (installers, extension zip)
dist/
out/

# Logs and caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
.npm/
.eslintcache
coverage/

# Local settings and secrets — never commit these
.env
.env.*
*.p12
*.pfx
*.cer
*.key
*.pem
*.mobileprovision

# Operating system clutter
.DS_Store
Thumbs.db
desktop.ini

# Editor folders
.vscode/
.idea/
*.swp
build/android-www/
