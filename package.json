{
  "name": "pocket-canvas",
  "productName": "Pocket-Canvas",
  "version": "1.5.0",
  "description": "A visual board app for organising ideas: notes, images, links, to-dos, columns and nested boards on an infinite canvas.",
  "main": "main.js",
  "author": {
    "name": "project-tech-me",
    "email": "project-tech-me@protonmail.com"
  },
  "homepage": "https://github.com/Projects-me-design/Pocket-Canvas",
  "repository": {
    "type": "git",
    "url": "https://github.com/Projects-me-design/Pocket-Canvas.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "electron tests/smoke.js",
    "test:features": "electron tests/features.js",
    "test:merge": "node tests/merge.test.js",
    "test:extension": "node tests/extension.test.js",
    "extension": "node scripts/build-extension.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "test:android": "node tests/mobile-web.test.js",
    "android:sync": "node scripts/build-mobile-web.js && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "node scripts/build-mobile-web.js && npx cap sync android && cd android && ./gradlew assembleRelease",
    "test:mobile": "node tests/mobile-web.test.js",
    "test:server": "node tests/server.test.js",
    "mobile:web": "node scripts/build-mobile-web.js",
    "ios:sync": "node scripts/build-mobile-web.js && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "server": "node server/pocket-canvas-server.js"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.projecttechme.pocket-canvas",
    "productName": "Pocket-Canvas",
    "copyright": "Copyright © 2026 project-tech-me",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "project-tech-me <project-tech-me@protonmail.com>",
      "vendor": "project-tech-me",
      "synopsis": "Visual boards for organising ideas"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "publish": null,
    "extraFiles": [
      "LICENSE",
      "ASSETS-LICENCE.md"
    ]
  }
}
