{
  "manifest_version": 3,
  "name": "Pocket-Canvas Web Clipper",
  "short_name": "Pocket-Canvas",
  "version": "1.3.0",
  "description": "Save web pages, pictures, videos, sounds, screenshots and selected text straight onto your Pocket-Canvas boards.",
  "author": "project-tech-me",
  "homepage_url": "https://github.com/Projects-me-design/Pocket-Canvas",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Save to Pocket-Canvas",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "lib.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "web-clipper@pocket-canvas.app",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
